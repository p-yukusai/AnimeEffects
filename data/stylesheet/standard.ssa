/**
 *  MAIN STYLESHEET
 *  ---------------
 */

QToolTip
{
    /* 0.2ex is the smallest value that's not ignored on Windows. */
    border: 0.04em solid @text@;
    background-image: none;
    background-color: @base@;
    alternate-background-color: @base@;
    color: @text@;
    padding: 0.1em;
    border-radius: 0.25em;
    opacity: 200;
}

QWidget
{
    background-color: @base@;
    selection-background-color: @textSelection@;
    selection-color: @text@;
    background-clip: border;
    border-image: none;

    /* QDialogButtonBox icons */
    dialog-cancel-icon: url(@icondir@/dialog_cancel.svg);
    dialog-close-icon: url(@icondir@/dialog_close.svg);
    dialog-ok-icon: url(@icondir@/dialog_ok.svg);
    dialog-open-icon: url(@icondir@/dialog_open.svg);
    dialog-reset-icon: url(@icondir@/dialog_reset.svg);
    dialog-save-icon: url(@icondir@/dialog_save.svg);
    dialog-yes-icon: url(@icondir@/dialog_ok.svg);
    dialog-help-icon: url(@icondir@/dialog_help.svg);
    dialog-no-icon: url(@icondir@/dialog_no.svg);
    dialog-apply-icon: url(@icondir@/dialog_ok.svg);
    dialog-discard-icon: url(@icondir@/dialog_discard.svg);

    /* QMessageBox icons */
    messagebox-critical-icon: url(@icondir@/message_critical.svg);
    messagebox-information-icon: url(@icondir@/message_information.svg);
    messagebox-question-icon: url(@icondir@/message_question.svg);
    messagebox-warning-icon: url(@icondir@/message_warning.svg);

    /* Arrow icons */
    uparrow-icon: url(@icondir@/up_arrow.svg);
    downarrow-icon: url(@icondir@/down_arrow.svg);
    leftarrow-icon: url(@icondir@/left_arrow.svg);
    rightarrow-icon: url(@icondir@/right_arrow.svg);
    backward-icon: url(@icondir@/left_arrow.svg);
    forward-icon: url(@icondir@/right_arrow.svg);

    /* Other icons */
    dockwidget-close-icon: url(@icondir@/close.svg);
}

QWidget:disabled
{
    color: @textDisabled@;
    background-color: @recessed@;
}

QCheckBox
{
    spacing: 0.23em;
    outline: none;
    color: @text@;
    margin-bottom: 0.09em;
    opacity: 200;
}

QCheckBox:disabled
{
    color: @textMuted@;
}

QCheckBox::indicator
{
    /* Elevated field-style box: the background separates it from the panel
       and a hairline (same 0.04em width as the fields' hover border, 1px at
       the 11pt font) outlines it at rest - unlike the borderless fields, a
       checkbox keeps its box visible without hover. Rest edge color @outline@
       sits between the @raised@ background and the @outline@ button border -
       darker means lower contrast against the panel. The check is the
       geometric phosphor glyph from the tinted set.
       0.75em box + 0.04em border = ~16px total (1em box rendered 23px). */
    width: 0.75em;
    height: 0.75em;
    background-color: @raised@;
    border: 0.04em solid @outline@;
    border-radius: 0.3em;
}

QCheckBox::indicator:hover
{
    border: 0.04em solid @hover@;
}

QCheckBox::indicator:focus
{
    border: 0.04em solid @focus@;
}

QCheckBox::indicator:checked
{
    image: url(@icondir@/check-bold.svg);
}

QCheckBox::indicator:indeterminate
{
    image: url(@icondir@/minus-bold.svg);
}

QCheckBox::indicator:disabled
{
    background-color: @recessed@;
    border: 0.04em solid @recessed@;
}

QRadioButton
{
    spacing: 0.23em;
    outline: none;
    color: @text@;
    margin-bottom: 0.09em;
}

QRadioButton:disabled
{
    color: @textDisabled@;
}

QRadioButton::indicator
{
    width: 1em;
    height: 1em;
}

QRadioButton::indicator:unchecked,
QRadioButton::indicator:unchecked:focus
{
    border-image: url(@icondir@/radio_unchecked_disabled.svg);
}

QRadioButton::indicator:unchecked:hover,
QRadioButton::indicator:unchecked:pressed
{
    border: none;
    outline: none;
    border-image: url(@icondir@/radio_unchecked.svg);
}

QRadioButton::indicator:checked
{
    border: none;
    outline: none;
    border-image: url(@icondir@/radio_checked.svg);
}

QRadioButton::indicator:checked:hover,
QRadioButton::indicator:checked:focus,
QRadioButton::indicator:checked:pressed
{
    border: none;
    outline: none;
    border-image: url(@icondir@/radio_checked.svg);
}

QRadioButton::indicator:checked:disabled
{
    outline: none;
    border-image: url(@icondir@/radio_checked_disabled.svg);
}

QRadioButton::indicator:unchecked:disabled
{
    border-image: url(@icondir@/radio_unchecked_disabled.svg);
}

QMenuBar
{
    background-color: @base@;
    color: @text@;
}

QMenuBar::item
{
    spacing: 0.5em;
    padding-top: 0.1875em;
    padding-bottom: 0.1875em;
    padding-left: 0.625em;
    padding-right: 0.625em;
    border-radius: 0.25em;
    background: transparent;
}

QMenuBar::item:selected
{
    background-color: @hairline@;
}

QMenuBar::item:disabled
{
    color: @textDisabled@;
}

QMenuBar::item:pressed
{
    background-color: @hairline@;
    color: @text@;
}

QMenu
{
    color: @text@;
    /* The panel — a rounded recessed surface with a 1px base-colored edge —
       is drawn by gui::ScrollBarStyle (the dark-theme proxy style): QSS
       paints the body's fill along the border's centerline while the
       widget's square backing fills the corner cut, so body and border
       could never share one curve. background: none (NoBrush) keeps the
       rule non-drawable so the QSS delegates the panel to the proxy; no
       background/border/radius here or the QSS takes it over. The padding
       insets the items. */
    background: none;
    padding-top: 0.3em;
    padding-bottom: 0.3em;
    /* inset the item rows 4px from the panel edges so the hover highlight
       does not run edge to edge */
    padding-left: 0.25em;
    padding-right: 0.25em;
}

/* QMenu::paintEvent passes State_None, so the QSS treats the panel as
   :disabled and QWidget:disabled's @recessed@ background would win the merge
   and paint a square body. Same specificity, later in the sheet: keep it
   non-drawable so the proxy draws the rounded panel. */
QMenu:disabled
{
    background: none;
}

QMenu::icon
{
    margin: 0.23em;
}

QMenu::item
{
    /* Add extra padding on the right for the QMenu arrow */
    padding: 0.23em 1.5em 0.23em 1.3em;
    border: none;
    background: transparent;
    border-radius: 0.25em;
}

QMenu::item:selected
{
    /* content on the accent fill: the 1.0 accentText, not the 0.96 theme
       text (same rule as the combo popup's proxy-drawn selected row) */
    color: @accentText@;
    /* a stronger accent tint than the tree selection: popup hover should
       read as accent, not as a muted selection */
    background-color: @accentHover@;
}

QMenu::item:selected:disabled
{
    background-color: @recessed@;
}

QMenu::item:disabled
{
    color: @textDisabled@;
}

QMenu::indicator
{
    width: 0.8em;
    height: 0.8em;
    /* To align with QMenu::icon, which has a 0.23em margin. */
    margin-left: 0.3em;
    subcontrol-position: center left;
}

QMenu::indicator:non-exclusive:unchecked
{
    border-image: url(@icondir@/checkbox_unchecked_disabled.svg);
}

QMenu::indicator:non-exclusive:unchecked:selected
{
    border-image: url(@icondir@/checkbox_unchecked_disabled.svg);
}

QMenu::indicator:non-exclusive:checked
{
    border-image: url(@icondir@/checkbox_checked.svg);
}

QMenu::indicator:non-exclusive:checked:selected
{
    border-image: url(@icondir@/checkbox_checked.svg);
}

QMenu::indicator:exclusive:unchecked
{
    border-image: url(@icondir@/radio_unchecked_disabled.svg);
}

QMenu::indicator:exclusive:unchecked:selected
{
    border-image: url(@icondir@/radio_unchecked_disabled.svg);
}

QMenu::indicator:exclusive:checked
{
    border-image: url(@icondir@/radio_checked.svg);
}

QMenu::indicator:exclusive:checked:selected
{
    border-image: url(@icondir@/radio_checked.svg);
}

QMenu::right-arrow
{
    /* phosphor caret, the same glyph family as the combo's down-arrow. The
       old breeze chevron was a 60x90 border-image that stretched into a
       massive arrow no matter the declared size. */
    margin: 0.23em;
    image: url(@icondir@/caret-right.svg);
    width: 0.5em;
    height: 0.5em;
}

QAbstractItemView
{
    alternate-background-color: @base@;
    color: @text@;
    border: 0.09em solid @base@;
    border-radius: 0.09em;
}

QTabWidget:focus,
QCheckBox:focus,
QRadioButton:focus,
QSlider:focus
{
    border: none;
}

QLineEdit
{
    background-color: @raised@;
    padding: 0.23em;
    border-style: solid;
    /* Borderless at rest: background establishes the hierarchy, matching the
       spinboxes; the border appears on hover/focus via the shared rule below. */
    border: 0.04em solid transparent;
    border-radius: 0.25em;
    color: @text@;
}

QAbstractScrollArea
{
    /* border: none (not just absent) actually suppresses the native Fusion
       frame, so scrollbars sit flush at the area's edge and the mouse can
       reach them at the window edge. */
    border: none;
    background-color: transparent;
}

/**
 *  This is the background for the box in the bottom-right corner
 *  whene both scrollbars are active.
 */
QAbstractScrollArea::corner
{
    background: @base@;
}

/**
 *  Can't do the KDE style of where the scrollbar handle
 *  becomes light on the hover, and only when the handle
 *  is hovered does it become stylized. This is because
 *  both the handle and the background events are treated
 *  together.
 */

QTextEdit
{
    background-color: @raised@;
    color: @text@;
    /* Borderless at rest, border on hover/focus - matches the other fields. */
    border: 0.04em solid transparent;
}

QPlainTextEdit
{
    background-color: @recessed@;
    color: @text@;
    border-radius: 0.25em;
    /* Borderless at rest, border on hover/focus - matches the other fields. */
    border: 0.04em solid transparent;
}



QMenu::separator
{
    /* a 1px hairline in the @hairline@ token, like every other separator */
    height: 1px;
    margin: 0;
    background-color: @hairline@;
    padding-left: 0.2em;
    margin-top: 0.375em;
    margin-bottom: 0.375em;
    margin-left: 0.41em;
    margin-right: 0.41em;
}

QFrame[frameShape="2"], /* QFrame::Panel == 0x0003 */
QFrame[frameShape="3"], /* QFrame::WinPanel == 0x0003 */
QFrame[frameShape="4"], /* QFrame::HLine == 0x0004 */
QFrame[frameShape="5"], /* QFrame::VLine == 0x0005 */
QFrame[frameShape="6"]  /* QFrame::StyledPanel == 0x0006 */
{
    border-width: 0.04em;
    padding: 0.09em;
    border-style: solid;
    border-color: @base@;
    background-color: @textDisabled@;
    border-radius: 0.23em;
}

/* Provide highlighting for frame objects. */
QFrame[frameShape="2"]:hover,
QFrame[frameShape="3"]:hover,
QFrame[frameShape="4"]:hover,
QFrame[frameShape="5"]:hover,
QFrame[frameShape="6"]:hover
{
    border: 0.04em solid @hover@;
}

/* Don't provide an outline if we have a widget that takes up the space. */
QFrame[frameShape] QAbstractItemView:hover
{
    border: 0em solid black;
}

/**
 *  Note: I can't really change the background of the toolbars
 *  independently, since KDE Breeze has different colors for the
 *  window bar and the rest of the UI. The top toolbar uses
 *  the window style, and the rest use the application style,
 *  which we can't do.
 */
QToolBar
{
    font-weight: bold;
}

QToolBar:horizontal
{
    background: 0.09em solid @base@;
}

QToolBar:vertical
{
    background: 0.09em solid @base@;
}

QToolBar QToolButton
{
    font-weight: bold;
    border: 0.04em transparent black;
    padding-left: 0.2em;
    padding-right: 0.3em;
}

QToolBar QToolButton:hover
{
    border: 0.04em solid @hover@;
}

QToolBar QToolButton:pressed
{
    border: 0.04em solid @hover@;
    /* The padding doesn't inherit from `QToolBar QToolButton`, so leave it in. */
    padding-left: 0.2em;
    padding-right: 0.3em;
}

/**
 *  Special rules for a QFileDialog.
 *
 *  Due to the widgets, we get rid of the min sizes to allow them
 *  to pack closer together, and ensure we have enough padding for
 *  the drop-down menu in the popup.
 */
QDialog QToolBar QToolButton[popupMode="0"],
QDialog QToolBar QToolButton[popupMode="1"]
{
    padding-left: 0.1em;
    padding-right: 0.1em;
}

QDialog QToolBar QToolButton[popupMode="2"]
{
    padding-left: 0.1em;
    padding-right: 0.7em;
}

QPushButton
{
    color: @text@;
    background-color: @raised@;
    border: 1px solid @outline@;
    padding: 0.25em 0.75em;
    border-radius: 0.25em;
    outline: none;
    min-height: 1.125em;
}

QComboBox:open,
QPushButton:open
{
    border-width: 1px;
    border-color: @outline@;
}

QComboBox:closed,
QPushButton:closed
{
    border-width: 1px;
    border-color: @outline@;
}

QPushButton:disabled
{
    color: @textDisabled@;
    background-color: @recessed@;
    border: 1px solid @base@;
    padding: 0.25em 0.75em;
    border-radius: 0.25em;
    outline: none;
    min-height: 1.125em;
}

QPushButton:focus
{
    color: @text@;
    border-color: @focus@;
}

QPushButton:pressed
{
    background-color: @active@;
    border-color: @outline@;
    color: @text@;
}

QComboBox
{
    /* Borderless at rest, border on hover/focus - matches the other fields. */
    border: 0.04em solid transparent;
    border-radius: 0.25em;
    padding: 0.23em;
    min-width: 2.5em;
}

QComboBox:editable
{
    background-color: @raised@;
}

QPushButton:checked
{
    background-color: @active@;
    border: 1px solid @outline@;
    color: @text@;
}

QPushButton:hover
{
    background-color: @raisedHover@;
    border: 1px solid @hover@;
    color: @text@;
}

QPushButton:checked:hover
{
    background-color: @activeHover@;
    border: 1px solid @outline@;
    color: @text@;
}

QComboBox:hover,
QAbstractSpinBox:hover,
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QAbstractView:hover,
QTreeView:hover
{
    border: 0.04em solid @hover@;
    color: @text@;
}

QComboBox:focus,
QAbstractSpinBox:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QTreeView:focus
{
    border: 0.04em solid @focus@;
    color: @text@;
}

QComboBox:hover:pressed:!editable,
QAbstractSpinBox:hover:pressed,
QLineEdit:hover:pressed,
QTextEdit:hover:pressed,
QPlainTextEdit:hover:pressed,
QAbstractView:hover:pressed,
QTreeView:hover:pressed
{
    background-color: @recessed@;
}

QColumnView
{
    border: 0.04em transparent @base@;
}

/* Each column in the view is a QAbstractItemView. */
QColumnView QAbstractItemView
{
    border: 0.04em transparent @focus@;
}

/**
 *  In order to set consistency between Qt5 and Qt6, we need
 *  to ensure that we do the following steps:
 *      1. Set a consistent `max-height` in the item. Anything
 *         below `0.8em` will cause clipping, so set that value
 *         to ensure the icon isn't larger.
 *      2. Set padding to ensure the item is properly padded.
 *      3. Set `0.2em` margins on the top and bottom of the arrows,
 *         and `0.1em` on the left and right to ensure the arrows
 *         are properly padded and have the same size.
 *
 *  The size consistency only works if both the `::item` subcontrol
 *  `max-height` and the `::*-arrow` subcontrol `margin` is set.
 */
QColumnView QAbstractItemView::item
{
    padding: 0.23em;
    max-width: 0.5em;
    max-height: 0.8em;
}

QColumnView QAbstractItemView::right-arrow
{
    image: url(@icondir@/right_arrow.svg);
    margin: 0.2em 0.1em 0.2em 0.1em;
}

QColumnView QAbstractItemView::right-arrow:selected,
QColumnView QAbstractItemView::right-arrow:hover
{
    image: url(@icondir@/right_arrow_hover.svg);
}

QColumnView QAbstractItemView::left-arrow
{
    image: url(@icondir@/left_arrow.svg);
    margin: 0.2em 0.1em 0.2em 0.1em;
}

QColumnView QAbstractItemView::left-arrow:selected,
QColumnView QAbstractItemView::left-arrow:hover
{
    image: url(@icondir@/left_arrow_hover.svg);
}

QComboBox:hover:pressed:editable
{
    background-color: @recessed@;
}

QComboBox QAbstractItemView
{
    /* The popup panel (recessed body, base edge) is drawn by the
       ScrollBarStyle proxy via PE_PanelMenu; keep the view transparent so
       the panel shows instead of a base card. The item rows are drawn by
       the popup's CE_MenuItem path (the ::item QSS rules do not reach
       them); the proxy draws the selected row flat/rounded like a QMenu
       item and separators as centered hairlines. */
    background-color: transparent;
    outline-color: 0em;
    border-radius: 0.5em;
}

QComboBox::drop-down
{
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 0.65em;

    border-left-width: 0em;
    border-left-style: solid;
    border-top-right-radius: 0.13em;
    border-bottom-right-radius: 0.13em;
}

QComboBox::down-arrow
{
    /* phosphor caret triangle from the tinted canonical set - the same
       glyph the light themes use, instead of the old breeze chevron */
    image: url(@icondir@/caret-down.svg);
    width: 0.8em;
    height: 0.8em;
    margin-right: 0.41em;
}

QAbstractSpinBox
{
    padding: 0.23em;
    /* Borderless at rest: the background color alone separates the field.
       The transparent border keeps the same geometry, so showing the border
       on hover/focus below does not shift or resize the field. */
    border: 0.09em solid transparent;
    background-color: @raised@;
    color: @text@;
    border-radius: 0.25em;
    min-width: 3em;
    min-height: 1em;
}

QAbstractSpinBox:hover
{
    border: 0.09em solid @hover@;
}

QAbstractSpinBox:up-button,
QAbstractSpinBox:up-button:hover
{
    background-color: transparent;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    padding-right: 0.1em;
    width: 0.8em;
    /* 1em caps the arrow glyph: a button taller than the field (the old 3em
       full-height overshoot) made QStyleSheetStyle draw the arrows scaled to
       the whole field height. 1em keeps a comfortable click target and a
       small centered glyph. */
    height: 1em;
}

QAbstractSpinBox:down-button,
QAbstractSpinBox:down-button:hover
{
    background-color: transparent;
    subcontrol-origin: padding;
    subcontrol-position: center left;
    padding-left: 0.1em;
    width: 0.8em;
    /* 1em caps the arrow glyph: a button taller than the field (the old 3em
       full-height overshoot) made QStyleSheetStyle draw the arrows scaled to
       the whole field height. 1em keeps a comfortable click target and a
       small centered glyph. */
    height: 1em;
}

/**
 *  Bug fixes for elongated items in QSpinBoxes.
 *  By default, the items are bounded by `down-button`
 *  and `up-button`, so this doesn't actually affect the styling.
 *
 *  This does however affect some custom styling using
 *  QStyle.CC_ComboBox, which affects QDateEdit. This cannot
 *  be selected using QDateEdit, since it uses a global style.
 *  This sounds nonsensical, because CC_ComboBox isn't a spin box,
 *  but through trial and error, this is in fact the case.
 *
 *  Affects #40.
 */
QAbstractSpinBox::up-arrow,
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off,
QAbstractSpinBox::up-arrow:!off:!disabled:hover,
QAbstractSpinBox::down-arrow,
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off,
QAbstractSpinBox::down-arrow:!off:!disabled:hover
{
    border-image: none;
    /* 0.75em x 0.5em tracks the font (icon size paired to font size):
       ~14x9px at the 11pt system font, ~11x7px at 9pt. Centered in the
       1em button. Phosphor bold carets keep a solid core at this size
       (~12 solid px at 14x9); the thin breeze wedge anti-aliased away at
       the old 0.6em x 0.375em, killing the accent hover color. */
    width: 0.75em;
    height: 0.5em;
}

QAbstractSpinBox::up-arrow
{
    image: url(@icondir@/caret-up-bold.svg);
}

QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off
{
    image: url(@icondir@/caret-up-bold-disabled.svg);
}

QAbstractSpinBox::up-arrow:hover
{
    image: url(@icondir@/caret-up-bold-hover.svg);
}

QAbstractSpinBox::down-arrow
{
    image: url(@icondir@/caret-down-bold.svg);
}

QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off
{
    image: url(@icondir@/caret-down-bold-disabled.svg);
}

QAbstractSpinBox::down-arrow:!off:!disabled:hover
{
    image: url(@icondir@/caret-down-bold-hover.svg);
}

QDoubleSpinBox
{
    min-width: 4em;
}

/**
 *  `QCalendarWidget QAbstractItemView:enabled` sets the color, background
 *  color, and selection color for active dates in the view.
 *  `QCalendarWidget QAbstractItemView:enabled` sets the disabled dates.
 */
QCalendarWidget QAbstractItemView:enabled
{
    color: @text@;
    selection-color: @text@;
    selection-background-color: @selection@;
}

/* Won't take hover events. */
QPrevNextCalButton
{
    min-width: 0.8em;
    min-height: 1.2em;
    qproperty-iconSize: 0 0;
}

/**
