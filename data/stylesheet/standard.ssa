{
    image: url(@icondir@/right_arrow_disabled.svg);
}

QToolButton::left-arrow:disabled
{
    image: url(@icondir@/left_arrow_disabled.svg);
}

QToolButton::up-arrow:disabled
{
    image: url(@icondir@/up_arrow_disabled.svg);
}

QToolButton::down-arrow:disabled
{
    image: url(@icondir@/down_arrow_disabled.svg);
}

QToolButton::menu-indicator
{
    border-image: none;
    image: url(@icondir@/down_arrow.svg);
    width: 0.8em;
    height: 0.5em;
    left: -0.09em;
    /* -1.2em + 0.09em */
    padding-right: -1.11em;
    /**
     *  Qt5 and Qt6 differ if the subcontrol-origin is set to
     *  the default, AKA, padding. Setting it to the content,
     *  which we adjust the padding to, makes it uniform between
     *  both.
     */
    subcontrol-origin: content;
    subcontrol-position: right;
}

/**
 *  Special rule for the drop-down indicator in a QFileDialog.
 *  We want these to be more compact, hence the smaller padding.
 */
QDialog QToolBar QToolButton[popupMode="2"]::menu-indicator
{
    padding-right: -0.7em;
}

QToolButton::menu-arrow
{
    border-image: none;
    image: url(@icondir@/down_arrow.svg);
    width: 0.8em;
    height: 0.5em;
    padding-right: 0.09em;
    subcontrol-position: right;
}

QToolButton::menu-button
{
    border-top-right-radius: 0.5em;
    border-bottom-right-radius: 0.5em;
    /* 1ex width + 0.4ex for border + no text = 2ex allocated above */
    width: 1.3em;
    padding: 0.23em;
    outline: none;
}

QToolButton::menu-button::menu-arrow
{
    left: -0.09em;
    subcontrol-position: right;
}

QToolButton::menu-button:hover
{
    background-color: transparent;
}

QToolButton::menu-button:pressed
{
    background-color: transparent;
    padding: 0.23em;
    outline: none;
}

QTableView
{
    border: 0em solid black;
    gridline-color: @hairline@;
    background-color: @base@;
}

QTableView:!selected,
QTableView:selected
{
    border: 0em solid black;
}

QTableView
{
    border-radius: 0em;
}

/* Selected items render as one muted brand-tinted state for every state
   (active, inactive, hover); the fill is the selection token (@selection@),
   the brand hue at low elevation. (No `color` anywhere in the ::item rules:
   a matching QSS color would override the per-item foreground brush the
   object tree uses to dim hidden labels, including the gentler dim it keeps
   on a selected row. Unbrushed items draw the palette's Text role, which is
   the same @text@ token.) */
QAbstractItemView::item:pressed,
QAbstractItemView::item:selected:!active,
QAbstractItemView::item:selected:active,
QAbstractItemView::item:selected:hover
{
    background: @selection@;
}

QHeaderView
{
    background-color: @base@;
    border: 0.04em transparent;
    border-radius: 0em;
    margin: 0em;
    padding: 0em;
}

QHeaderView::section
{
    background-color: @base@;
    border: 0.04em solid @textDisabled@;
    color: @text@;
    border-radius: 0em;
    padding: 0em 0.23em 0em 0.23em;
    text-align: center;
}

QHeaderView::section::vertical::first,
QHeaderView::section::vertical::only-one
{
    border-top: 0.04em solid @textDisabled@;
}

QHeaderView::section::vertical
{
    border-top: transparent;
}

QHeaderView::section::horizontal::first,
QHeaderView::section::horizontal::only-one
{
    border-left: 0.04em solid @textDisabled@;
}

QHeaderView::section::horizontal
{
    border-left: transparent;
}

QHeaderView[showSortIndicator="true"]::section::horizontal
{
    /* Same as the width of the arrow subcontrols below. */
    padding-right: 0.8em;
}

QHeaderView::section:checked
{
    color: @text@;
    background-color: @selection@;
}

/* Note that this doesn't work for QTreeView unless the header is clickable */
QHeaderView::section:hover,
QHeaderView::section::horizontal::first:hover,
QHeaderView::section::horizontal::only-one:hover,
QHeaderView::section::vertical::first:hover,
QHeaderView::section::vertical::only-one:hover
{
    background-color: @hairline@;
}

QHeaderView[showSortIndicator="true"]::down-arrow
{
    image: url(@icondir@/down_arrow.svg);
    /**
     *  Qt5 and Qt6 differ if the subcontrol-origin is set to
     *  the default, AKA, padding. Setting it to the content,
     *  which we adjust the padding to, makes it uniform between
     *  both.
     */
    subcontrol-origin: content;
    subcontrol-position: center right;
    width: 0.8em;
    height: 0.5em;
    /**
     *  Qt5 and Qt6 have different ideas of the padding of the
     *  arrow subcontrols: using `padding-left` to ensure that
     *  the width is undone fixes the padding of the content by
     *  an extra `0.8em` in Qt6, but doesn't affect Qt5.
     */
    padding-right: 0.09em;
    padding-left: -0.8em;
}

QHeaderView[showSortIndicator="true"]::up-arrow
{
    image: url(@icondir@/up_arrow.svg);
    subcontrol-origin: content;
    subcontrol-position: center right;
    width: 0.8em;
    height: 0.5em;
    padding-right: 0.09em;
    padding-left: -0.8em;
}

QTableView QTableCornerButton::section
{
    background-color: @base@;
    border: 0.04em transparent @textDisabled@;
    border-top: 0.04em solid @textDisabled@;
    border-left: 0.04em solid @textDisabled@;
    border-radius: 0em;
}

/* No hover event */
QTableView QTableCornerButton:hover
{
    border: 0.04em transparent @textDisabled@;
}

QTableView QTableCornerButton::section:pressed
{
    border: 0.04em solid @hover@;
    border-radius: 0em;
}

QToolBox
{
    padding: 0.23em;
    border: 0.09em transparent black;
}

QToolBox::tab
{
    border-bottom: 0.09em solid @textDisabled@;
    margin-left: 1.5em;
}

QToolBox::tab:selected
{
    border-bottom: 0.09em solid @focus@;
}

QToolBox::tab:hover
{
    border-bottom: 0.09em solid @hover@;
}

/* Resizable dividers:
   - QSplitter handles (ThinSplitter): width 0 in the layout, so panels
     tile edge-to-edge; the hairline and hitbox are the ThinSplitter's
     overlay, so the handle itself paints nothing.
   - QMainWindow dock separators: 0px and invisible; the hairline and the
     12px hitbox are the DockSash overlay (src/gui/DockSash.cpp), which
     resizes docks through QMainWindow::resizeDocks. (Styling the native
     separator itself is a dead end: the universal QWidget background fills
     over any separator `background`, and a 1px `border` costs 2px of
     layout.) */
QSplitter::handle
{
    background: transparent;
    border: none;
}

QMainWindow::separator
{
    background: transparent;
    border: none;
}

QMainWindow::separator:vertical
{
    width: 0;
}

QMainWindow::separator:horizontal
{
    height: 0;
}

/**
 *  It's not possible to get satisfactory rounded borders here.
 *  If you set the border to be negative, while adjusting the
 *  widths, you get an asymmetrical curve which produces an
 *  unappealing border.
 */
QProgressBar:horizontal,
QProgressBar:vertical
{
    background-color: @active@;
    border: 0.9em solid @base@;
    border-radius: 0.13em;
    padding: 0em;
}

QProgressBar:horizontal
{
    height: 0.2em;
    min-width: 6em;
    text-align: right;
    padding-left: -0.03em;
    padding-right: -0.03em;
    margin-top: 0.2em;
    margin-bottom: 0.2em;
    margin-right: 1.3em;
}

QProgressBar:vertical
{
    width: 0.2em;
    min-height: 6em;
    text-align: bottom;
    padding-top: -0.03em;
    padding-bottom: -0.03em;
    margin-left: 0.2em;
    margin-right: 0.2em;
    margin-bottom: 0.41em;
}

QProgressBar::chunk:horizontal,
QProgressBar::chunk:vertical
{
    background-color: @focus@;
    border: 0.9em transparent;
    border-radius: 0.08em;
}

QScrollArea,
QScrollArea:focus,
QScrollArea:hover
{
    border: 0em solid black;
}

/* ICONS */
/**
 *  Qt's built-in icons can look pretty bad if the system theme
 *  is a different color than the current one. For example, when
 *  using a dark theme, with a light UI, the `Ok` button is greyed
 *  out for an about dialog.
 *
 *  QDialogButtonBox will apply for all standard buttons in all standard
 *  widgets, such as QMessageBox, etc. However, we do need to override
 *  standard icons elsewhere.
 *
 *  The rest of the icons make little sense to implement:
 *      Qt uses native window decorations.
 *      Qt normally uses native file dialogs, which look nicer.
 *      Media controls are used in custom widgets, which aren't standard.
 */
QDialogButtonBox
{
    dialogbuttonbox-buttons-have-icons: true;

    dialog-cancel-icon: url(@icondir@/dialog_cancel.svg);
    dialog-close-icon: url(@icondir@/dialog_close.svg);
    dialog-ok-icon: url(@icondir@/dialog_ok.svg);
    dialog-open-icon: url(@icondir@/dialog_open.svg);
    dialog-reset-icon: url(@icondir@/dialog_reset.svg);
    dialog-save-icon: url(@icondir@/dialog_save.svg);
    /**
     *  No support yet for overriding saveall.
     *  dialog-saveall-icon: url(@icondir@/dialog_saveall.svg);
     */
    dialog-yes-icon: url(@icondir@/dialog_ok.svg);
    dialog-help-icon: url(@icondir@/dialog_help.svg);
    dialog-no-icon: url(@icondir@/dialog_no.svg);
    dialog-apply-icon: url(@icondir@/dialog_ok.svg);
    dialog-discard-icon: url(@icondir@/dialog_discard.svg);
}

/* Set some styles for these custom dialog buttons */
QDialogButtonBox QPushButton,
QMessageBox QPushButton
{
    min-height: 1.1em;
    min-width: 5em;
}

/**
 *  Special rules for creating a custom titlebar. This can only work
 *  when setting the Qt property `isTitlebar` to `true`.
 */
QWidget[isTitlebar="true"],
QWidget[isTitlebar="true"] *
{
    background-color: @base@;
}

/**
 *  Special rules for creating a border around a top-level frame of a window.
 *  This can only work when setting the Qt property `isWindow` to `true`.
 *  We've manually enumerated border widths from 1-5 below.
 */
QFrame[isWindow="true"],
QFrame[frameShape][isWindow="true"]
{
    border: 0 transparent @recessed@;
}

QFrame[isWindow="true"][windowFrame="1"],
QFrame[frameShape][isWindow="true"][windowFrame="1"]
{
    border: 1px solid @recessed@;
    border-radius: 0.1875em;
}

QFrame[isWindow="true"][windowFrame="2"],
QFrame[frameShape][isWindow="true"][windowFrame="2"]
{
    border: 0.125em solid @recessed@;
    border-radius: 0.1875em;
}

QFrame[isWindow="true"][windowFrame="3"],
QFrame[frameShape][isWindow="true"][windowFrame="3"]
{
    border: 0.1875em solid @recessed@;
    border-radius: 0.1875em;
}

QFrame[isWindow="true"][windowFrame="4"],
QFrame[frameShape][isWindow="true"][windowFrame="4"]
{
    border: 0.25em solid @recessed@;
    border-radius: 0.1875em;
}

QFrame[isWindow="true"][windowFrame="5"],
QFrame[frameShape][isWindow="true"][windowFrame="5"]
{
    border: 0.3125em solid @recessed@;
    border-radius: 0.1875em;
}

/* Scrollbars are rendered by gui::ScrollBarStyle (a QProxyStyle drawing a
   deterministic 4px pill) — the QSS border-image path for scrollbar
   subcontrols distorts small pills. The track is invisible; the pill is
   muted at rest and brightens on hover.

   QScrollBar must carry background: none: the universal QWidget background
   rule would otherwise give the scrollbar a drawable, and QStyleSheetStyle
   then draws the default QWindowsStyle scrollbar instead of delegating to
   the proxy (background: none parses to a NoBrush background, so
   hasDrawable() stays false). */
QScrollBar {
    background: none;
}
