/*
 *  Tool dock stylesheet (breeze_dark).
 *
 *  Design tokens (breeze_dark v2):
 *    base @base@: the dock surface == the window floor.
 *    hairline @hairline@: 1px separators between major sections.
 *    ghost buttons: transparent at rest; hover @hairline@; pressed @recessed@
 *    (down but alive — above the inert recess, below hover).
    active (checked tool) @active@; the toolbox row uses the brand-accent hue
    (Oklch 279.3) instead. Tracks recess (@recessed@).
 */

/* the dock's single surface */
#toolWidget {
    background-color: @base@;
}

QGroupBox {
    color: @text@;
    background-color: transparent;
    border: none;
    border-radius: 0;
    /* section-title weight: the title renders with the box font (Qt ignores
       font-* on the ::title subcontrol), so semibold lives here */
    font-weight: 600;
    /* 2px top margin + 3px bottom padding = ~5px around the 1px section
       hairline, tight enough that the line does the separating */
    margin-top: 0.125em;
    padding-left: 0.375em;
    padding-right: 0.375em;
    /* padding-top makes room for the title INSIDE the section: title text
       spans y=10..24 (6px margin + 10px title offset), content starts at 32;
       padding-bottom just breathes, a whisper below the content */
    padding-top: 1.8125em;
    padding-bottom: 0.1875em;
}

/* slider/checkbox labels stay regular (the box font cascades to children) */
QGroupBox QLabel, QGroupBox QCheckBox {
    font-weight: 400;
}

/* The Toolbox row and the tool settings panel are one unit: exactly one
   tool panel is visible at a time, always directly below the row, so no
   hairline separates them. The unit's boundary with View Settings is the
   ViewPanel's own bottom hairline below. */
#viewPanel {
    border-bottom: 1px solid @hairline@;
    padding-bottom: 0.625em;
}

QGroupBox::title {
    /* dimmed like the property dock's subheaders (@textMuted@) */
    color: @textMuted@;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    /* offset past the top margin so the label sits on the surface,
       aligned with the content inset instead of straddling the edge */
    padding-top: 0.625em;
    padding-left: 0.375em;
}

QPushButton {
    color: @text@;
    background-color: transparent;
    border: none;
    border-radius: 0.25em;
    /* 18px glyph + 3px padding = exactly the 24x24 button grid; the QSS
       box math (padding is content-level) means min-height tricks inflate
       the box, so the padding is the sizing lever here. min-width/height
       must be 0: standard.ssa leaks min-height through the cascade and
       inflates the setFixedSize(24,24) tool buttons past square */
    padding: 0.1875em;
    min-width: 0;
    min-height: 0;
}

QPushButton:hover {
    background-color: @hairline@;
}

QPushButton:pressed {
    background-color: @recessed@;
}

QPushButton:checked {
    background-color: @active@;
}

QPushButton:checked:hover {
    background-color: @activeHover@;
}

/* the mode/option rows inside the tool panels (SingleOutItem buttons)
   highlight with the brand accent, matching the toolbox row (#modePanel).
   Scoped to the modeButton tag: the View Settings panel shares this dock
   stylesheet and keeps the neutral active fill. */
QPushButton[modeButton="true"]:checked {
    background-color: @accent@;
}

QPushButton[modeButton="true"]:checked:hover {
    background-color: @accent@;
}

/* active tool (the toolbox row only) uses the brand-accent hue at the same
   lightness as the neutral active token, so it reads as "active" with a tint.
   The glyph stays the theme text color (white on the accent in dark, like
   Cloudflare on orange / Figma on blue). */
#modePanel QPushButton:checked {
    background-color: @accent@;
}
#modePanel QPushButton:checked:hover {
    background-color: @accent@;
}

QPushButton:disabled {
    color: @textDisabled@;
    background-color: transparent;
}

/* Tool-panel sliders (FFD/Bone/Pose/etc. option rows) are custom-painted by
   gui::tool::ToolSlider: Qt QSS subcontrol rendering caps border-radius
   below half the box (radius >= half draws a plain rectangle) and folds
   groove margins into the track height, so a clean circular head on a 4px
   track is not reliably reachable with stylesheets. ToolSlider draws the
   track (4px), the accent-filled portion, the recessed empty portion, and
   the accent circular head with QPainter using the theme tokens. */

QCheckBox#checkItem {
}

QCheckBox#checkItem::indicator {
    /* same size as the property dock's checkboxes (QCheckBox#keyIcon) */
    margin: 0;
    padding: 0;
    width: 0.9375em;
    height: 0.9375em;
}
