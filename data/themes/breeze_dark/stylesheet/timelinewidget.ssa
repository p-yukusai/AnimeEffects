gui--TimeLineEditorWidget {
    qproperty-headerContentColor: rgba(200, 200, 200, 255);
    qproperty-headerBackgroundColor: rgba(38, 38, 38, 255);
    qproperty-rulerLineColor: rgba(52, 52, 52, 255);


    qproperty-trackColor: rgba(38, 38, 38, 255);
    /* the row seams are hairlines like every other separator in the theme;
       the dotted lane separators sit one step above so they stay legible */
    qproperty-trackEdgeColor: rgba(52, 52, 52, 255);
    qproperty-trackTextColor: rgba(195, 195, 195, 255);
    /* the selected track is a 40% tint of the selection color — a full-width
       solid fill would dominate the timeline (unlike the small tree row) */
    qproperty-trackSelectColor: rgba(54, 56, 109, 102);
    qproperty-trackSeperatorColor: rgba(74, 75, 76, 255);
}

gui--TimeCursor {
    qproperty-numberColor: rgba(255, 255, 255, 255);
    qproperty-edgeColor: rgba(97, 85, 245, 255);
}