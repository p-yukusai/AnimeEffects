/*
 *  Playback widget stylesheet (breeze_dark).
 *
 *  Same tokens as the tool dock: 4px controls, feedback via background.
 */

QPushButton {
    color: #eff0f1;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

QPushButton:hover {
    background-color: #484848;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QPushButton:checked {
    background-color: #626568;
}

QPushButton:checked:hover {
    background-color: #6f7376;
}

QPushButton:disabled {
    color: #707070;
    background-color: #2c2c2c;
}
