/*
 *  Playback widget stylesheet (breeze_dark).
 *
 *  Same tokens as the tool dock: 4px controls, feedback via background.
 */

QPushButton {
    color: #f0f0f0;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

QPushButton:hover {
    background-color: #343434;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QPushButton:checked {
    background-color: #646464;
}

QPushButton:checked:hover {
    background-color: #737373;
}

QPushButton:disabled {
    color: #707070;
    background-color: transparent;
}
