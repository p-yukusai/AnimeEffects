/*
 *  Tool dock stylesheet (breeze_dark).
 *
 *  Design tokens:
 *    radius:  4px controls, 8px containers
 *    surface hierarchy: window #323232 > panel #2d2d2d > button #3d3d3d
 *    interactive feedback is expressed with background color only;
 *    borders are never used to give a control its shape.
 */

QGroupBox {
    color: #eff0f1;
    background-color: #2d2d2d;
    border: none;
    border-radius: 8px;
    margin-top: 6px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 12px;
    padding-bottom: 24px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    color: #eff0f1;
}

QPushButton {
    color: #eff0f1;
    background-color: #3d3d3d;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

QPushButton:hover {
    background-color: #484848;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QPushButton:checked {
    background-color: #626568;
}

QPushButton:checked:hover {
    background-color: #6f7376;
}

QPushButton:disabled {
    color: #707070;
    background-color: #2c2c2c;
}

QSlider::groove:horizontal {
    height: 3px;
    background: #2c2c2c;
    border: none;
    border-radius: 2px;
    margin: 2px 0;
}

QSlider::handle:horizontal {
    background: #7e7e7e;
    border: none;
    width: 7px;
    margin: -6px 0; /* handle is placed by default on the contents rect of the groove. Expand outside the groove */
    border-radius: 4px;
}

QCheckBox#checkItem {
}

QCheckBox#checkItem::indicator {
    margin: 0px;
    padding: 4px;
    width: 16px;
    height: 16px;
}
