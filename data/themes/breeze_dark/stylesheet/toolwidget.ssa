/*
 *  Tool dock stylesheet (breeze_dark).
 *
 *  Design tokens (breeze_dark v2):
 *    base #262626: the dock surface == the window floor.
 *    hairline #343434: 1px separators between major sections.
 *    ghost buttons: transparent at rest; hover #343434; pressed #2f2f2f
 *    (down but alive — above the inert recess, below hover).
    active (checked tool) #646464; the toolbox row uses the brand-accent hue
    (Oklch 279.3) instead. Tracks recess (#1f1f1f).
 */

/* the dock's single surface */
ToolWidget {
    background-color: #262626;
}

QGroupBox {
    color: #f0f0f0;
    background-color: transparent;
    border: none;
    border-radius: 0px;
    /* section-title weight: the title renders with the box font (Qt ignores
       font-* on the ::title subcontrol), so semibold lives here */
    font-weight: 600;
    /* 2px top margin + 3px bottom padding = ~5px around the 1px section
       hairline, tight enough that the line does the separating */
    margin-top: 2px;
    padding-left: 6px;
    padding-right: 6px;
    /* padding-top makes room for the title INSIDE the section: title text
       spans y=10..24 (6px margin + 10px title offset), content starts at 32;
       padding-bottom just breathes, a whisper below the content */
    padding-top: 26px;
    padding-bottom: 3px;
}

/* slider/checkbox labels stay regular (the box font cascades to children) */
QGroupBox QLabel, QGroupBox QCheckBox {
    font-weight: 400;
}

/* hairline separators between the major sections (all panels except the
   first; hidden panels don't render, so this stays correct as tool
   panels appear/disappear) */
ModePanel, SRTPanel, FFDPanel, BonePanel, PosePanel, MeshPanel {
    border-top: 1px solid #343434;
}

QGroupBox::title {
    /* dimmed like the property dock's subheaders (#d8d8d8) */
    color: #d8d8d8;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    /* offset past the top margin so the label sits on the surface,
       aligned with the content inset instead of straddling the edge */
    padding-top: 10px;
    padding-left: 6px;
}

QPushButton {
    color: #f0f0f0;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    /* 18px glyph + 3px padding = exactly the 24x24 button grid; the QSS
       box math (padding is content-level) means min-height tricks inflate
       the box, so the padding is the sizing lever here */
    padding: 3px;
}

QPushButton:hover {
    background-color: #343434;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QPushButton:checked {
    background-color: #646464;
}

QPushButton:checked:hover {
    background-color: #737373;
}

/* active tool (the toolbox row only) uses the brand-accent hue at the same
   lightness as the neutral active token, so it reads as "active" with a tint */
#modePanel QPushButton:checked {
    background-color: #4a49a9; /* Oklch(0.46, 0.15, 279.3) */
}
#modePanel QPushButton:checked:hover {
    background-color: #5252b2; /* Oklch(0.49, 0.15, 279.3) */
}

QPushButton:disabled {
    color: #707070;
    background-color: transparent;
}

QSlider::groove:horizontal {
    height: 3px;
    background: #1f1f1f;
    border: none;
    border-radius: 2px;
    margin: 2px 0;
}

QSlider::handle:horizontal {
    background: #7e7e7e;
    border: none;
    width: 7px;
    margin: -6px 0; /* handle is placed by default on the contents rect of the groove. Expand outside the groove */
    border-radius: 4px;
}

QCheckBox#checkItem {
}

QCheckBox#checkItem::indicator {
    /* same size as the property dock's checkboxes (QCheckBox#keyIcon) */
    margin: 0px;
    padding: 0px;
    width: 15px;
    height: 15px;
}
