/*
 *  Tool dock stylesheet (breeze_dark_high_dpi).
 *
 *  Em-based mirror of breeze_dark/stylesheet/toolwidget.ssa so the dock
 *  scales with the font size. Tokens: 0.25em controls, 0.5em containers;
 *  feedback via background color only.
 */

QGroupBox {
    color: #eff0f1;
    background-color: #2d2d2d;
    border: none;
    border-radius: 0.5em;
    margin-top: 0.375em;
    padding-left: 0.375em;
    padding-right: 0.375em;
    padding-top: 0.75em;
    padding-bottom: 1.5em;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    color: #eff0f1;
}

QPushButton {
    color: #eff0f1;
    background-color: #3d3d3d;
    border: none;
    border-radius: 0.25em;
    padding: 0.125em;
}

QPushButton:hover {
    background-color: #484848;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QPushButton:checked {
    background-color: #626568;
}

QPushButton:checked:hover {
    background-color: #6f7376;
}

QPushButton:disabled {
    color: #707070;
    background-color: #2c2c2c;
}

QSlider::groove:horizontal {
    height: 0.1875em;
    background: #2c2c2c;
    border: none;
    border-radius: 0.125em;
    margin: 0.125em 0;
}

QSlider::handle:horizontal {
    background: #7e7e7e;
    border: none;
    width: 0.4375em;
    margin: -0.375em 0;
    border-radius: 0.25em;
}

QCheckBox#checkItem {
}

QCheckBox#checkItem::indicator {
    margin: 0px;
    padding: 0.25em;
    width: 1em;
    height: 1em;
}
