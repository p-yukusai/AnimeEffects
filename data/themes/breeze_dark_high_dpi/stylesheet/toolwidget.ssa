/*
 *  Tool dock stylesheet (breeze_dark_high_dpi).
 *
 *  Em-based mirror of breeze_dark/stylesheet/toolwidget.ssa so the dock
 *  scales with the font size. Tokens: 0.25em controls, 0.5em containers;
 *  feedback via background color only.
 */

/* the dock's single surface */
ToolWidget {
    background-color: #262626;
}

/* hairline separators between the major sections (all panels except the
   first; hidden panels don't render, so this stays correct as tool
   panels appear/disappear) */
ModePanel, SRTPanel, FFDPanel, BonePanel, PosePanel, MeshPanel {
    border-top: 1px solid #343434;
}

QGroupBox {
    color: #f0f0f0;
    background-color: transparent;
    border: none;
    border-radius: 0em;
    /* section-title weight: the title renders with the box font (Qt ignores
       font-* on the ::title subcontrol), so semibold lives here */
    font-weight: 600;
    /* 0.25em top margin + 0.375em bottom padding = ~5px around the 1px
       section hairline, tight enough that the line does the separating */
    margin-top: 0.25em;
    padding-left: 0.375em;
    padding-right: 0.375em;
    /* padding-top makes room for the title INSIDE the card (mirrors the
       px theme: title offset = margin + 0.625em, content follows);
       padding-bottom just breathes, a whisper below the content */
    padding-top: 1.625em;
    padding-bottom: 0.375em;
}

/* slider/checkbox labels stay regular (the box font cascades to children) */
QGroupBox QLabel, QGroupBox QCheckBox {
    font-weight: 400;
}

QGroupBox::title {
    /* dimmed like the property dock's subheaders (#d8d8d8) */
    color: #d8d8d8;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    /* offset past the top margin so the label sits inside the card,
       aligned with the content inset instead of straddling the edge */
    padding-top: 0.625em;
    padding-left: 0.375em;
}

QPushButton {
    color: #f0f0f0;
    background-color: transparent;
    border: none;
    border-radius: 0.25em;
    /* px, not em: 18px glyph + 3px padding = the 24x24 button grid the
       code enforces (see the breeze_dark sheet for the box-math note) */
    padding: 3px;
}

QPushButton:hover {
    background-color: #343434;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QPushButton:checked {
    background-color: #646464;
}

QPushButton:checked:hover {
    background-color: #737373;
}

/* active tool (the toolbox row only) uses the brand-accent hue at the same
   lightness as the neutral active token, so it reads as "active" with a tint */
#modePanel QPushButton:checked {
    background-color: #4a49a9; /* Oklch(0.46, 0.15, 279.3) */
}
#modePanel QPushButton:checked:hover {
    background-color: #5252b2; /* Oklch(0.49, 0.15, 279.3) */
}

QPushButton:disabled {
    color: #707070;
    background-color: transparent;
}

QSlider::groove:horizontal {
    height: 0.1875em;
    background: #1f1f1f;
    border: none;
    border-radius: 0.125em;
    margin: 0.125em 0;
}

QSlider::handle:horizontal {
    background: #7e7e7e;
    border: none;
    width: 0.4375em;
    margin: -0.375em 0;
    border-radius: 0.25em;
}

QCheckBox#checkItem {
}

QCheckBox#checkItem::indicator {
    /* same size as the property dock's checkboxes (QCheckBox#keyIcon) */
    margin: 0px;
    padding: 0px;
    width: 1.2em;
    height: 1.2em;
}
