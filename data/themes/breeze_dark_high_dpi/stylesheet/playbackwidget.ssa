/*
 *  Playback widget stylesheet (breeze_dark_high_dpi).
 *
 *  Em-based mirror of breeze_dark/stylesheet/playbackwidget.ssa.
 */

QPushButton {
    color: #f0f0f0;
    background-color: transparent;
    border: none;
    border-radius: 0.25em;
    padding: 0.125em;
}

QPushButton:hover {
    background-color: #484848;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QPushButton:checked {
    background-color: #646464;
}

QPushButton:checked:hover {
    background-color: #737373;
}

QPushButton:disabled {
    color: #707070;
    background-color: #2c2c2c;
}
