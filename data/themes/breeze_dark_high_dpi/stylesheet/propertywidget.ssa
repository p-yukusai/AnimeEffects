QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width:  16px;
    height: 16px;
}

QComboBox::down-arrow {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-down.svg);
    width:   10px;
    height:  10px;
}
QComboBox::down-arrow:disabled {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-down.svg);
}

QSplitter#propertysplitter {
    width: 18em;
    padding-right: 0.4em;
}

QFrame#holder {
    background-color: #323232;
    border-radius: 0.5em;
}

QCheckBox#keyIcon {
}

QCheckBox#keyIcon::indicator {
    width: 1.2em;
    height: 1.2em;
}
QCheckBox#keyIcon::indicator:unchecked {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-right.svg);
}

QCheckBox#keyIcon::indicator:checked {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-down.svg);
}

QGroupBox#keyGroup {
    background-color: #323232;
    border:0em solid transparent;
    border-radius:0.5em;
    margin: 0.2em;
    padding-top: 1.8em;
    padding-bottom: 0.4em;
}

QGroupBox#keyGroup::title {
    subcontrol-origin: margin;
    subcontrol-position:top left;
	spacing: 1em;
    padding-left: 0em;
    padding-top: 0em;
	padding-bottom: 0.8em
}

QGroupBox#keyGroup::indicator {
    width: 1.2em;
    height: 1.2em;
    padding-left: 0.5em;
    padding-bottom: 0.2em;
}

QGroupBox#keyGroup::indicator:unchecked {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-right.svg);
}

QGroupBox#keyGroup::indicator:checked {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-down.svg);
}

QGroupBox#attrGroup {
    border-radius:0.5em;
    margin: 0.2em;
    padding-top: 1.6em;
    padding-bottom: 0.4em;
}

QGroupBox#attrGroup::title {
    subcontrol-origin: margin;
    subcontrol-position:top left;
	spacing: 1em;
    padding-left: 0em;
    padding-top: 0em;
	padding-bottom: 0.8em
}

QGroupBox#attrGroup::indicator {
    width: 1.2em;
    height: 1.2em;
    padding-left: 0.5em;
    padding-bottom: 0.2em;
}

QGroupBox#attrGroup::indicator:unchecked {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-right.svg);
}

QGroupBox#attrGroup::indicator:checked {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-down.svg);
}

QGroupBox#keyKnocker {
    background-color: #323232;
    border:0em solid transparent;
    border-radius:0.5em;
    margin: 0.2em;
    padding-top: 0.4em;
    padding-bottom: 0.4em;
}

QPushButton#keyKnocker {
    border: 0.1em solid #76797c;
    border-radius: 0.25em;
    padding: 0em;
    margin: 0em;
    width: 1em;
    height: 0.9em;
}
QPushButton#keyKnocker::enabled {
    image: url(data/themes/breeze_dark_high_dpi/icon/plus.svg);
}
QPushButton#keyKnocker::disabled {
    image: url(data/themes/breeze_dark_high_dpi/icon/minus.svg);
}

QPushButton#browser {
    border: 0.1em solid #76797c;
    border-radius: 0.25em;
    padding: 0.2em;
    width: 1.8em;
    height: 1.5em;
}
QPushButton#browser::enabled {
    image: url(data/themes/breeze_dark_high_dpi/icon/file.svg);
}
QPushButton#browser::disabled {
    image: url(data/themes/breeze_dark_high_dpi/icon/file.svg);
}

QGroupBox#propertyPanel {
   background-color: #2d2d2d;
   border:0em solid transparent;
   border-radius:0.5em;
   margin: 0.2em;
   padding-top: 1.6em;
   padding-bottom: 0.4em;
}

QGroupBox#propertyPanel::title {
    subcontrol-origin: margin;
    subcontrol-position:top left;
	spacing: 1em;
    padding-left: 0em;
    padding-top: 0em;
	padding-bottom: 0.8em
}

QGroupBox#propertyPanel::indicator {
    width: 1.2em;
    height: 1.2em;
    padding-left: 0.5em;
    padding-bottom: 0.2em;
}

QGroupBox#propertyPanel::indicator:unchecked {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-right.svg);
}

QGroupBox#propertyPanel::indicator:checked {
    image: url(data/themes/breeze_dark_high_dpi/icon/caret-down.svg);
}
