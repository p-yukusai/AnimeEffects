/*
 *  Tool dock stylesheet (default).
 *
 *  Design tokens:
 *    radius:  4px controls, 8px containers
 *    surface hierarchy: window #ececec > panel #fcfcfc > button #f2f2f2
 *    interactive feedback is expressed with background color only;
 *    borders are never used to give a control its shape.
 */

QGroupBox {
    color: #3c3c3c;
    background-color: #fcfcfc;
    border: none;
    border-radius: 8px;
    margin-top: 6px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 12px;
    padding-bottom: 24px;
}

QGroupBox::title {
    font-weight: bold;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    color: #3c3c3c;
}

QPushButton {
    color: #3c3c3c;
    background-color: #f2f2f2;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

QPushButton:hover {
    background-color: #e6e6e6;
}

QPushButton:pressed {
    background-color: #d8d8d8;
}

QPushButton:checked {
    background-color: #e0e8f5;
}

QPushButton:checked:hover {
    background-color: #d2ddec;
}

QPushButton:disabled {
    color: #9a9a9a;
    background-color: #efefef;
}

QSlider::groove:horizontal {
    height: 3px;
    background: #e0e0e0;
    border: none;
    border-radius: 2px;
    margin: 2px 0;
}

QSlider::handle:horizontal {
    background: #fdfdfd;
    border: 1px solid #a0a0b0;
    width: 7px;
    margin: -6px 0; /* handle is placed by default on the contents rect of the groove. Expand outside the groove */
    border-radius: 4px;
}

QCheckBox#checkItem {
}

QCheckBox#checkItem::indicator {
    margin: 0px;
    padding: 4px;
    width: 16px;
    height: 16px;
}
