QWidget {
    background-color: #ececec;
    color: #101010;
}

QMenuBar {
    color: #000000;
    background-color: #ececec;
}

QMenuBar::item {
    spacing: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 10px;
    padding-right: 10px;
    background: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    color: #303030;
    background-color: #e6e6e6;
}

QMenuBar::item:pressed {
    color: #101010;
    background-color: #d8d8d8;
}

QMenu {
    color: #101010;
    background-color: #fcfcfc;
    /* border-radius is ignored unless a border is declared (QRenderRule::borderClip) */
    border: 1px solid transparent;
    border-radius: 8px;
}

QMenu::separator {
    height: 1px;
    margin: 4px 8px;
    background-color: #c8c8c8;
}

QFrame {
    background-color: #f6f6f6;
}

QScrollArea {
    background-color: #f0f0f0;
    border: none;
}

QPlainTextEdit {
    background-color: #f4f4f4;
    color: #303030;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
}

QSplitter::handle:horizontal {
    color: #000000;
    background-color: #f6f6f6;
}
QSplitter::handle:vertical {
    color: #000000;
    background-color: #f6f6f6;
}

QComboBox {
    color: #101010;
    padding-left: 8px;
    padding-bottom: 1px;
}

QDoubleSpinBox, QSpinBox {
    color: #101010;
}

QDoubleSpinBox::disabled, QSpinBox::disabled {
    color: #808080;
    background-color: #ececec;
}

QLineEdit {
    color: #101010;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
}

QLineEdit:focus {
    border-color: #8ab4f8;
}

QLineEdit::read-only {
    color: #303030;
    background-color: #f4f4f4;
    border: 1px solid #d8d8d8;
    border-radius: 3px;
}

QLineEdit::disabled {
    color: #9a9a9a;
    background-color: #ececec;
    border: 1px solid #d8d8d8;
}

QLabel {
    color: #101010;
    background-color: transparent;
}

QGroupBox {
    background-color: #fcfcfc;
    border: 1px solid transparent;
    border-radius: 8px;
    margin-top: 0ex;
    padding-top: 16px;
}

QGroupBox::title {
    color: #000000;
    subcontrol-origin: margin;
    subcontrol-position:top left;
    padding-left: 8px;
}

QGroupBox::indicator:unchecked {
    image: url(data/themes/default/icon/caret-right.svg);
}

QGroupBox::indicator:checked {
    image: url(data/themes/default/icon/caret-down.svg);
}

QGroupBox#note {
    background-color: #f8f8f8;
    border: 1px solid #d8d8d8;
    border-radius: 8px;
    margin-top: 0px;
    padding-top: 0px;
}

QDockWidget {
    color: #303030;
    background: #ececec;
    /* title deliberately unstyled: a styled title bar renders a hard border
       around the dock (mirrors the dark theme's approach). */
}

QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border-radius: 3px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: #d8d8d8;
}

QDockWidget::close-button:pressed, QDockWidget::float-button:pressed {
    background: #c0c0c0;
}

QPushButton {
    color: #202020;
    background-color: #f2f2f2;
    border: 1px solid #b8b8b8;
    border-radius: 4px;
    padding: 4px 12px;
    outline: none;
}

QPushButton:disabled {
    color: #9a9a9a;
    background-color: #f6f6f6;
    border: 1px solid #d0d0d0;
}

QPushButton:hover {
    color: #202020;
    background-color: #e6e6e6;
    border: 1px solid #a8a8a8;
}

QPushButton:pressed {
    color: #202020;
    background-color: #d8d8d8;
    border: 1px solid #b8b8b8;
}

QPushButton#standardButton {
    padding: 2px 4px 2px 4px;
    width: 54px;
    height: 22px;
}

QPushButton#standardButton:disabled {
    padding-top: 2px;
}

QPushButton#standardButton:hover {
    padding-top: 2px;
}

QPushButton#standardButton:pressed {
    padding-top: 2px;
}

QPushButton#browser {
    border: 1px solid #a0a0a0;
    border-radius: 4px;
    padding: 2px;
    width: 18px;
    height: 15px;
}
QPushButton#browser::enabled {
    image: url(data/themes/default/icon/file.svg);
}
QPushButton#browser::disabled {
    image: url(data/themes/default/icon/file.svg);
}

QTreeView#objectTree {
    background: #fafafa;
    show-decoration-selected: 1;
    border-radius: 1px;
    border: none;
}

QTreeView#objectTree::item {
    background-color: transparent;
}

QTreeView#objectTree::item:hover {
    background-color: #eef2f7;
}

QTreeView#objectTree::item:selected {
    background-color: #dde6f2;
    color: #202020;
}

QTreeView#objectTree::item:selected:active{
    background-color: #d4dfee;
    color: #202020;
}

QTreeView#objectTree::item:selected:!active {
    background-color: #e4e9f0;
    color: #202020;
}

QTreeView#objectTree::indicator:unchecked {
    image: url(data/themes/default/icon/eye-close.svg);
}

QTreeView#objectTree::indicator:checked {
    image: url(data/themes/default/icon/eye-open.svg);
}

QTreeView#resourceTree {
    background: #fafafa;
    show-decoration-selected: 1;
    border-radius: 2px;
    border: none;
}

QTreeView#resourceTree::item {
    color: #000000;
    background-color: transparent;
}

QTreeView#resourceTree::item:hover {
    background-color: #eef2f7;
}

QTreeView#resourceTree::item:selected {
    background-color: #dde6f2;
    color: #202020;
}

QTreeView#resourceTree::item:selected:active{
    background-color: #d4dfee;
    color: #202020;
}

QTreeView#resourceTree::item:selected:!active {
    background-color: #e4e9f0;
    color: #202020;
}

