/* Scrollbars: slim track, pill handle. QStyleSheetStyle ignores border-radius
   on scrollbar subcontrols, so the pill shape comes from a border-image
   (transparent corners carry the curve); hover swaps to the lighter image. */
QScrollBar:horizontal
{
    background-color: #f0f0f0;
    height: 0.65em;
    margin: 0.13em 0.65em 0.13em 0.65em;
    border: 0.04em transparent #f0f0f0;
}

QScrollBar:vertical
{
    background-color: #f0f0f0;
    width: 0.65em;
    margin: 0.65em 0.13em 0.65em 0.13em;
    border: 0.04em transparent #f0f0f0;
}

QScrollBar::handle:horizontal
{
    border: 2px solid transparent;
    border-image: url(data/themes/default/icon/scrollbar_handle.png) 5;
    min-width: 0.5em;
}

QScrollBar::handle:horizontal:hover
{
    border-image: url(data/themes/default/icon/scrollbar_handle_hover.png) 5;
}

QScrollBar::handle:vertical
{
    border: 2px solid transparent;
    border-image: url(data/themes/default/icon/scrollbar_handle.png) 5;
    min-height: 0.5em;
}

QScrollBar::handle:vertical:hover
{
    border-image: url(data/themes/default/icon/scrollbar_handle_hover.png) 5;
}

QScrollBar::add-line:horizontal
{
    margin: 0em 0.13em 0em 0.13em;
    border-image: url(data/themes/default/icon/breeze/transparent.svg);
    width: 0.41em;
    height: 0.41em;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal
{
    margin: 0em 0.13em 0em 0.13em;
    border-image: url(data/themes/default/icon/breeze/transparent.svg);
    width: 0.41em;
    height: 0.41em;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover,
QScrollBar::add-line:horizontal:on
{
    border-image: url(data/themes/default/icon/breeze/transparent.svg);
    width: 0.41em;
    height: 0.41em;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal:hover,
QScrollBar::sub-line:horizontal:on
{
    border-image: url(data/themes/default/icon/breeze/transparent.svg);
    width: 0.41em;
    height: 0.41em;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical
{
    margin: 0.13em 0em 0.13em 0em;
    border-image: url(data/themes/default/icon/breeze/transparent.svg);
    height: 0.41em;
    width: 0.41em;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical
{
    margin: 0.13em 0em 0.13em 0em;
    border-image: url(data/themes/default/icon/breeze/transparent.svg);
    height: 0.41em;
    width: 0.41em;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:hover,
QScrollBar::sub-line:vertical:on
{
    border-image: url(data/themes/default/icon/breeze/transparent.svg);
    height: 0.41em;
    width: 0.41em;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover,
QScrollBar::add-line:vertical:on
{
    border-image: url(data/themes/default/icon/breeze/transparent.svg);
    height: 0.41em;
    width: 0.41em;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical
{
    background: none;
}

QScrollBar::up-arrow:horizontal,
QScrollBar::down-arrow:horizontal,
QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical
{
    background: none;
}
