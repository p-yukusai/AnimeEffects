QSplitter#propertysplitter {
    width: 380px;
}

QFrame#holder {
    background-color: #fafafa;
    border-radius:8px;
}

QComboBox {
    border-radius: 4px;
    color: #101010;
    padding-top: 1px;
    padding-left: 8px;
    padding-bottom: 1px;
}

QComboBox::enabled {
    color: #101010;
}

QComboBox::disabled {
    background-color: #ececec;
    color: #808080;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width:  16px;
    height: 16px;
    border: 0px solid #d0d0d0;
}

QComboBox::down-arrow {
    image: url(data/themes/default/icon/caret-down.svg);
    width:   10px;
    height:  10px;
}
QComboBox::down-arrow:disabled {
    image: url(data/themes/default/icon/caret-down.svg);
}

QCheckBox#keyIcon {
}

QCheckBox#keyIcon::indicator {
    width: 15px;
    height: 15px;
}
QCheckBox#keyIcon::indicator:unchecked {
    image: url(data/themes/default/icon/caret-right.svg);
}

QCheckBox#keyIcon::indicator:checked {
    image: url(data/themes/default/icon/caret-down.svg);
}

QFrame#keyGroup {
    background-color: #f8f8f8;
    border:0px solid transparent;
    border-radius:8px;
    margin: 0px;
    padding-bottom: 0px;
}
QAbstractButton#keyGroupHeader QLabel {
    background-color: transparent;
    font-weight: bold;
    color: #333333;
}
QAbstractButton#keyGroupHeader QLabel[hover="true"] {
    color: #101010;
}
QAbstractButton#keyGroupHeader {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    min-height: 24px;
}




/* field labels sit a step below the values they describe */
QLabel#attrLabel {
    /* transparent: same rationale as the knocker label */
    background-color: transparent;
    color: #2b2b2b;
}
QFrame#attrGroup {
    background-color: #f8f8f8;
    border:0px solid transparent;
    border-radius:8px;
    margin: 0px;
    padding-bottom: 0px;
}
QAbstractButton#attrGroupHeader QLabel {
    background-color: transparent;
    font-weight: bold;
    color: #333333;
}
QAbstractButton#attrGroupHeader QLabel[hover="true"] {
    color: #101010;
}
QAbstractButton#attrGroupHeader {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    min-height: 24px;
}



QWidget#keyKnocker QLabel {
    background-color: transparent;
    font-weight: bold;
    color: #333333;
}
QWidget#keyKnocker QLabel[hover="true"] {
    color: #101010;
}
QWidget#keyKnocker {
    /* the add-key row is the section header's stand-in: same
       geometry and states, plus icon instead of the caret; the
       whole row knocks the key. */
    background-color: transparent;
    border: none;
    border-radius: 0px;
    min-height: 24px;
}
QToolButton#keyKnockerPlus {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    min-width: 0px;
    min-height: 0px;
}


QPushButton#browser {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    min-width: 0px;
    min-height: 0px;
    width: 16px;
    height: 16px;
}
QPushButton#browser::enabled {
    image: url(data/themes/default/icon/file.svg);
}
QPushButton#browser:hover {
    background-color: #243c3c3c;
}
QPushButton#browser:pressed {
    background-color: #403c3c3c;
}
QPushButton#browser:disabled {
    background-color: transparent;
    image: url(data/themes/default/icon/file-dim.svg);
}

QFrame#propertyPanel {
    background-color: #f4f4f4;
    border:0px solid transparent;
    border-radius:8px;
    margin-top: 2px;
    margin-bottom: 4px;
    margin-left: 2px;
    margin-right: 2px;
    padding-bottom: 4px;
}
QAbstractButton#propertyPanelHeader QLabel {
    background-color: transparent;
    font-weight: bold;
}
QAbstractButton#propertyPanelHeader QLabel[hover="true"] {
    color: #000000;
}
QAbstractButton#propertyPanelHeader {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    min-height: 32px;
}
QAbstractButton#propertyPanelHeader QLabel {
    background-color: transparent;
    font-weight: bold;
}


