/*
 *  Playback widget stylesheet (default/classic).
 *
 *  Transparent buttons; background appears only on hover/active feedback.
 */

QPushButton {
    color: #3c3c3c;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

QPushButton:hover {
    background-color: #e0e0e0;
}

QPushButton:pressed {
    background-color: #d0d0d0;
}

QPushButton:checked {
    background-color: #dbe6f7;
}

QPushButton:checked:hover {
    background-color: #cddbf0;
}

QPushButton:disabled {
    color: #9a9a9a;
}
