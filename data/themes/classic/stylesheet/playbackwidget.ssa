/*
 *  Playback widget stylesheet (classic).
 *
 *  Same tokens as the tool dock: 4px controls, feedback via background.
 */

QPushButton {
    color: #3c3c3c;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

QPushButton:hover {
    background-color: #e6e6e6;
}

QPushButton:pressed {
    background-color: #d8d8d8;
}

QPushButton:checked {
    background-color: #e0e8f5;
}

QPushButton:checked:hover {
    background-color: #d2ddec;
}

QPushButton:disabled {
    color: #9a9a9a;
    background-color: #efefef;
}
